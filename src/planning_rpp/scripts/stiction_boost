#!/usr/bin/env python3
"""Boost in-place turn commands until the skid-steer base actually turns.

Sits between Nav2's velocity_smoother and the base driver:

    velocity_smoother -> cmd_vel_smoothed -> stiction_boost -> cmd_vel

A skid-steer base needs a large angular command to break wheel friction when
turning on the spot, but turns easily once moving. When the command is an
in-place turn and the measured yaw rate (EKF /odom) stays below
stall_yaw_rate for longer than stall_delay, the angular command magnitude is
ramped up at boost_rate (like an integral term) up to max_angular_vel. Once
the robot is turning, the boost decays over decay_time. All other commands
pass through unchanged. Only magnitudes are compared, so the sign convention
of the yaw-rate measurement does not matter.
"""
import math

import rclpy
from rclpy.node import Node
from geometry_msgs.msg import Twist
from nav_msgs.msg import Odometry


class StictionBoost(Node):

    def __init__(self):
        super().__init__('stiction_boost')
        self.enabled = self.declare_parameter('enabled', True).value
        # A command is an in-place turn when |v| < linear_deadband and
        # |w| > angular_deadband.
        self.linear_deadband = self.declare_parameter(
            'linear_deadband', 0.05).value
        self.angular_deadband = self.declare_parameter(
            'angular_deadband', 0.05).value
        # Measured |yaw rate| below this counts as not turning.
        self.stall_yaw_rate = self.declare_parameter(
            'stall_yaw_rate', 0.15).value
        self.stall_delay = self.declare_parameter('stall_delay', 0.3).value
        # Boost growth while stalled (rad/s per second).
        self.boost_rate = self.declare_parameter('boost_rate', 2.0).value
        self.decay_time = self.declare_parameter('decay_time', 0.5).value
        self.max_angular_vel = self.declare_parameter(
            'max_angular_vel', 3.0).value
        self.odom_timeout = self.declare_parameter('odom_timeout', 0.5).value

        self.boost = 0.0
        self.stalled_time = 0.0
        self.last_cmd_time = None
        self.yaw_rate = 0.0
        self.last_odom_time = None

        self.pub = self.create_publisher(Twist, 'cmd_vel', 10)
        self.create_subscription(
            Twist, 'cmd_vel_smoothed', self.on_cmd, 10)
        self.create_subscription(Odometry, 'odom', self.on_odom, 10)

    def on_odom(self, msg):
        self.yaw_rate = abs(msg.twist.twist.angular.z)
        self.last_odom_time = self.get_clock().now()

    def odom_fresh(self, now):
        return (self.last_odom_time is not None and
                (now - self.last_odom_time).nanoseconds / 1e9 <
                self.odom_timeout)

    def on_cmd(self, msg):
        now = self.get_clock().now()
        dt = 0.0
        if self.last_cmd_time is not None:
            dt = min(max((now - self.last_cmd_time).nanoseconds / 1e9, 0.0),
                     0.2)
        self.last_cmd_time = now

        w = msg.angular.z
        turning_in_place = (abs(msg.linear.x) < self.linear_deadband and
                            abs(w) > self.angular_deadband)

        # Without a fresh yaw-rate measurement we cannot tell a stall from a
        # turn, so never boost blind.
        if not (self.enabled and turning_in_place and self.odom_fresh(now)):
            self.boost = 0.0
            self.stalled_time = 0.0
            self.pub.publish(msg)
            return

        if self.yaw_rate < self.stall_yaw_rate:
            self.stalled_time += dt
            if self.stalled_time > self.stall_delay:
                self.boost += self.boost_rate * dt
        else:
            self.stalled_time = 0.0
            self.boost *= math.exp(-dt / self.decay_time)

        # Anti-windup: never let the boost exceed what can be commanded.
        magnitude = min(abs(w) + self.boost, self.max_angular_vel)
        self.boost = magnitude - abs(w)
        if self.boost > 0.01:
            self.get_logger().info(
                f'stalled turn: boosting {abs(w):.2f} -> {magnitude:.2f} '
                f'rad/s (measured {self.yaw_rate:.2f})',
                throttle_duration_sec=1.0)

        out = Twist()
        out.linear = msg.linear
        out.angular.z = math.copysign(magnitude, w)
        self.pub.publish(out)


def main():
    rclpy.init()
    node = StictionBoost()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == '__main__':
    main()
