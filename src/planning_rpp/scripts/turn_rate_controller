#!/usr/bin/env python3
"""Closed-loop yaw-rate control for the skid-steer base, using the IMU gyro.

Sits between Nav2's velocity_smoother and the base driver (it replaces
stiction_boost in that slot):

    velocity_smoother -> cmd_vel_smoothed -> turn_rate_controller -> cmd_vel

Problem: the base turns by scrubbing its tyres, so the yaw rate it actually
achieves is well below the yaw rate it is asked for, especially for gentle
curves while driving. RPP assumes it gets what it asks for, so the robot
under-turns, swings wide of the path and corrects late.

Fix: compare the requested yaw rate (from Nav2) with the measured yaw rate
(EKF /odom twist, which comes from the H30 gyro) and adjust the command with
a feedforward + PI loop until they match:

    out = kff * w_ref + kp * (w_ref - w_meas) + integral

The integral term also handles static friction for turns on the spot (it
keeps building while the robot is stalled), which is what stiction_boost did.

Linear stall boost: if Nav2 asks the robot to drive but it has not moved for
stall_time (2 s) -- wheel odometry shows no speed and the gyro shows no
turning -- the forward/backward command is raised gradually (up to
max_linear_boost) until the robot breaks free, then the boost fades out.
The IMU alone cannot tell whether the robot is creeping forward (its
accelerometer only measures acceleration), so "not moving" uses the EKF
/odom twist: wheel-encoder speed plus the gyro yaw rate. Wheels spinning in
place against something do NOT trigger it (they read as moving), and a
command the collision monitor has zeroed is never boosted.

Safety:
  * With no fresh /odom the command passes through untouched.
  * When Nav2 asks for (almost) no rotation, the command passes through and
    the integral is cleared, so the robot never turns on its own.
  * The output never has the opposite sign to the request.
  * If the measured yaw rate keeps having the opposite sign to a clear turn
    command, the gyro sign or TF is wrong; the loop would then push the wrong
    way, so the node logs an error and falls back to pass-through.

Tuning: watch ~/debug (x = requested, y = measured, z = sent) with
    ros2 run rqt_plot rqt_plot /turn_rate_controller/debug/x \
        /turn_rate_controller/debug/y /turn_rate_controller/debug/z
y should track x. If it lags, raise ki; if it overshoots or wobbles, lower kp.
"""
import math

import rclpy
from rclpy.node import Node
from geometry_msgs.msg import Twist, Vector3
from nav_msgs.msg import Odometry


class TurnRateController(Node):

    def __init__(self):
        super().__init__('turn_rate_controller')
        p = self.declare_parameter
        self.enabled = p('enabled', True).value
        # Feedforward scale on the requested yaw rate. Raise above 1.0 if the
        # base consistently under-turns by a fixed proportion.
        self.kff = p('kff', 1.0).value
        self.kp = p('kp', 1.0).value
        self.ki = p('ki', 5.0).value             # rad/s added per (rad/s * s)
        self.i_max = p('i_max', 1.5).value       # rad/s, integral clamp
        self.max_angular_vel = p('max_angular_vel', 3.0).value
        # Requests below this count as "no rotation" (pass-through).
        self.angular_deadband = p('angular_deadband', 0.05).value
        # Minimum |command| for a turn on the spot (|v| < linear_deadband),
        # to break static friction immediately. 0 disables it; the integral
        # still builds while stalled.
        self.linear_deadband = p('linear_deadband', 0.05).value
        self.min_inplace_angular = p('min_inplace_angular', 0.0).value
        # Multiply the measurement by -1 here only if the check below fires
        # and the TF cannot be fixed.
        self.measured_sign = p('measured_sign', 1.0).value
        self.odom_timeout = p('odom_timeout', 0.5).value
        # Sign check: |w_ref| and |w_meas| above these, opposite signs, for
        # longer than sign_fault_time -> fall back to pass-through.
        self.sign_check_ref = p('sign_check_ref', 0.3).value
        self.sign_check_meas = p('sign_check_meas', 0.2).value
        self.sign_fault_time = p('sign_fault_time', 0.5).value
        # Linear stall boost (see module docstring).
        self.stall_boost = p('stall_boost', True).value
        self.stall_time = p('stall_time', 2.0).value          # s
        self.stall_speed = p('stall_speed', 0.02).value       # m/s
        self.stall_yaw_rate = p('stall_yaw_rate', 0.1).value  # rad/s
        self.linear_boost_rate = p('linear_boost_rate', 0.1).value  # m/s/s
        self.max_linear_boost = p('max_linear_boost', 0.15).value   # m/s
        self.max_linear_vel = p('max_linear_vel', 0.4).value        # m/s
        self.boost_decay_time = p('boost_decay_time', 1.0).value    # s
        # Moving "freely" = faster than this fraction of the command; until
        # then the boost is held, not faded.
        self.free_fraction = p('free_fraction', 0.5).value
        self.free_hold_time = p('free_hold_time', 0.5).value        # s
        # After a boost, a new stall within restall_window re-boosts after
        # only restall_time instead of the full stall_time.
        self.restall_window = p('restall_window', 3.0).value        # s
        self.restall_time = p('restall_time', 0.3).value            # s

        self.integral = 0.0
        self.last_ref_sign = 0.0
        self.last_cmd_time = None
        self.yaw_rate = 0.0
        self.last_odom_time = None
        self.wrong_sign_time = 0.0
        self.faulted = False
        self.linear_speed = 0.0
        self.stalled_time = 0.0
        self.linear_boost = 0.0
        self.since_boost = float('inf')
        self.free_time = 0.0

        self.pub = self.create_publisher(Twist, 'cmd_vel', 10)
        self.debug_pub = self.create_publisher(Vector3, '~/debug', 10)
        self.create_subscription(Twist, 'cmd_vel_smoothed', self.on_cmd, 10)
        self.create_subscription(Odometry, 'odom', self.on_odom, 10)
        self.get_logger().info(
            f'turn rate control {"on" if self.enabled else "off"}: '
            f'kff {self.kff} kp {self.kp} ki {self.ki} i_max {self.i_max}')

    def on_odom(self, msg):
        self.yaw_rate = self.measured_sign * msg.twist.twist.angular.z
        self.linear_speed = abs(msg.twist.twist.linear.x)
        self.last_odom_time = self.get_clock().now()

    def odom_fresh(self, now):
        return (self.last_odom_time is not None and
                (now - self.last_odom_time).nanoseconds / 1e9 <
                self.odom_timeout)

    def boost_linear(self, cmd, dt, now):
        """Raise cmd.linear.x if the robot should be driving but is stuck."""
        v = cmd.linear.x
        if not (self.stall_boost and abs(v) > self.linear_deadband and
                self.odom_fresh(now)):
            self.stalled_time = 0.0
            self.linear_boost = 0.0
            return
        moving = (self.linear_speed > self.stall_speed or
                  abs(self.yaw_rate) > self.stall_yaw_rate)
        if self.linear_speed > self.free_fraction * abs(v):
            self.free_time += dt
        else:
            self.free_time = 0.0
        free = self.free_time > self.free_hold_time
        self.since_boost += dt
        if self.linear_boost > 0.005:
            self.since_boost = 0.0
        if moving:
            self.stalled_time = 0.0
            if free:
                self.linear_boost *= math.exp(-dt / self.boost_decay_time)
        else:
            self.stalled_time += dt
            wait = (self.restall_time if self.since_boost < self.restall_window
                    else self.stall_time)
            if self.stalled_time > wait:
                self.linear_boost = min(
                    self.linear_boost + self.linear_boost_rate * dt,
                    self.max_linear_boost)
        if self.linear_boost > 0.005:
            magnitude = min(abs(v) + self.linear_boost, self.max_linear_vel)
            cmd.linear.x = math.copysign(magnitude, v)
            if not moving:
                self.get_logger().info(
                    f'stuck for {self.stalled_time:.1f} s: boosting speed '
                    f'{abs(v):.2f} -> {magnitude:.2f} m/s',
                    throttle_duration_sec=1.0)

    def passthrough(self, msg, dt, now, w_meas=float('nan')):
        self.integral = 0.0
        cmd = Twist()
        cmd.linear.x, cmd.linear.y, cmd.linear.z = (
            msg.linear.x, msg.linear.y, msg.linear.z)
        cmd.angular.z = msg.angular.z
        self.boost_linear(cmd, dt, now)
        self.pub.publish(cmd)
        self.debug_pub.publish(
            Vector3(x=msg.angular.z, y=w_meas, z=msg.angular.z))

    def on_cmd(self, msg):
        now = self.get_clock().now()
        dt = 0.0
        if self.last_cmd_time is not None:
            dt = min(max((now - self.last_cmd_time).nanoseconds / 1e9, 0.0),
                     0.2)
        self.last_cmd_time = now

        w_ref = msg.angular.z
        if not (self.enabled and not self.faulted and self.odom_fresh(now)):
            self.passthrough(msg, dt, now)
            return
        w_meas = self.yaw_rate
        if abs(w_ref) < self.angular_deadband:
            self.last_ref_sign = 0.0
            self.passthrough(msg, dt, now, w_meas)
            return

        # Gyro sign sanity check: a clear turn request with a clear turn the
        # other way means positive feedback; stop correcting.
        if (abs(w_ref) > self.sign_check_ref and
                abs(w_meas) > self.sign_check_meas and
                w_ref * w_meas < 0.0):
            self.wrong_sign_time += dt
            if self.wrong_sign_time > self.sign_fault_time:
                self.faulted = True
                self.get_logger().error(
                    'measured yaw rate keeps opposing the command: check the '
                    'IMU sign / TF (or set measured_sign). Falling back to '
                    'pass-through until restart.')
                self.passthrough(msg, dt, now, w_meas)
                return
        else:
            self.wrong_sign_time = 0.0

        # A new turn direction starts from a clean integral.
        ref_sign = math.copysign(1.0, w_ref)
        if ref_sign != self.last_ref_sign:
            self.integral = 0.0
        self.last_ref_sign = ref_sign

        err = w_ref - w_meas
        self.integral = min(max(self.integral + self.ki * err * dt,
                                -self.i_max), self.i_max)
        out = self.kff * w_ref + self.kp * err + self.integral

        # Never command the opposite direction to the request, and stay
        # within the base's limits. Back-calculate the integral when the
        # output saturates so it does not wind up.
        magnitude = abs(out) if out * w_ref > 0.0 else 0.0
        if abs(msg.linear.x) < self.linear_deadband:
            magnitude = max(magnitude, self.min_inplace_angular)
        limited = min(magnitude, self.max_angular_vel)
        if limited != magnitude or out * w_ref <= 0.0:
            self.integral = ref_sign * limited - self.kff * w_ref \
                - self.kp * err
            self.integral = min(max(self.integral, -self.i_max), self.i_max)

        cmd = Twist()
        cmd.linear.x, cmd.linear.y, cmd.linear.z = (
            msg.linear.x, msg.linear.y, msg.linear.z)
        cmd.angular.z = math.copysign(limited, w_ref)
        self.boost_linear(cmd, dt, now)
        self.pub.publish(cmd)
        self.debug_pub.publish(Vector3(x=w_ref, y=w_meas, z=cmd.angular.z))


def main():
    rclpy.init()
    node = TurnRateController()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == '__main__':
    main()
