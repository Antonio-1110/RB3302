#!/usr/bin/env python3
"""Make the skid-steer base actually turn at the rate Nav2 asks for.

Sits between the collision monitor and the base driver:

    velocity_smoother -> collision_monitor -> turn_rate_controller -> /cmd_vel

Why: recorded runs show the Wave Rover turns at only ~1/3 of the commanded
yaw rate while driving and ~1/2 when pivoting, and does not pivot at all
for small commands (wheel scrub). RPP assumes it gets what it asks for, so
the robot under-turns, swings wide into walls, and stalls in pivots.

How (deliberately simple):
  1. Feedforward from the base's measured response, which is a deadband
     plus a gain:  actual = (command - offset) / kff  (calibrate_turning,
     2026-10-28: pivot offset 0.40 / kff 2.09, driving 0.09 / 2.37). So to
     get the requested rate w the command is  sign(w) * (offset + kff*|w|),
     with separate values for pivoting and driving. The launch file loads
     them from maps/turn_calibration.yaml (written by calibrate_turning).
  2. Optional minimum pivot command (min_inplace_angular, 0 = off).
  3. Small PI trim on the gyro yaw rate (EKF /odom) for what the fixed
     scale misses. Reset whenever the turn direction changes, clamped to
     +-i_max, and never allowed to flip the turn direction.
  4. No pushing past the request (2026-10-29 recording): the base answers
     with ~0.1 s delay and a ~0.35 s time constant, so it keeps turning
     after the request drops. The dead-zone offset is only there to GET the
     robot turning, so it fades out as the measured rate reaches the
     requested one and is gone once the robot turns brake_band faster. When
     the robot turns faster than asked it is braked with kp_brake, and the
     integral only grows while the robot is slower than asked (it bleeds
     off otherwise). Before this, pivots ran at the 3.0 rad/s limit while
     already at the requested rate, and every correction overshot.
The linear velocity passes through unchanged. If /odom goes stale the trim
is dropped and only the feedforward is applied.

Tuning: watch ~/debug (x = requested, y = measured, z = sent):
    ros2 topic echo /turn_rate_controller/debug
"""
import math

import rclpy
from rclpy.node import Node
from geometry_msgs.msg import Twist, Vector3
from nav_msgs.msg import Odometry


class TurnRateController(Node):

    def __init__(self):
        super().__init__('turn_rate_controller')
        p = self.declare_parameter
        self.enabled = p('enabled', True).value
        # Defaults from the 2026-10-28 calibration of this base;
        # maps/turn_calibration.yaml overrides them.
        self.kff_inplace = p('kff_inplace', 2.09).value
        self.offset_inplace = p('offset_inplace', 0.40).value
        self.kff_moving = p('kff_moving', 2.37).value
        self.offset_moving = p('offset_moving', 0.09).value
        self.min_inplace_angular = p('min_inplace_angular', 0.0).value
        self.kp = p('kp', 0.3).value
        self.ki = p('ki', 0.5).value
        self.i_max = p('i_max', 0.3).value
        # Braking when the robot turns faster than asked (see point 4).
        self.kp_brake = p('kp_brake', 0.8).value
        self.brake_band = p('brake_band', 0.3).value     # rad/s
        self.i_bleed_time = p('i_bleed_time', 0.2).value  # s
        self.max_angular_vel = p('max_angular_vel', 3.0).value
        # |v| below this = pivot; |w| below angular_deadband = no turn.
        self.linear_deadband = p('linear_deadband', 0.05).value
        self.angular_deadband = p('angular_deadband', 0.05).value
        self.odom_timeout = p('odom_timeout', 0.5).value

        self.integral = 0.0
        self.last_sign = 0.0
        self.last_cmd_time = None
        self.yaw_rate = 0.0
        self.last_odom_time = None

        self.pub = self.create_publisher(Twist, 'cmd_vel', 10)
        self.debug_pub = self.create_publisher(Vector3, '~/debug', 10)
        self.create_subscription(Twist, 'cmd_vel_smoothed', self.on_cmd, 10)
        self.create_subscription(Odometry, 'odom', self.on_odom, 10)
        self.get_logger().info(
            f'turn rate control {"on" if self.enabled else "off"}: '
            f'pivot {self.offset_inplace} + {self.kff_inplace}*w, '
            f'driving {self.offset_moving} + {self.kff_moving}*w')

    def on_odom(self, msg):
        self.yaw_rate = msg.twist.twist.angular.z
        self.last_odom_time = self.get_clock().now()

    def on_cmd(self, msg):
        now = self.get_clock().now()
        dt = 0.0
        if self.last_cmd_time is not None:
            dt = min(max((now - self.last_cmd_time).nanoseconds / 1e9, 0.0),
                     0.2)
        self.last_cmd_time = now

        out = Twist()
        out.linear.x, out.linear.y, out.linear.z = (
            msg.linear.x, msg.linear.y, msg.linear.z)
        w_ref = msg.angular.z
        odom_fresh = (self.last_odom_time is not None and
                      (now - self.last_odom_time).nanoseconds / 1e9 <
                      self.odom_timeout)

        if not self.enabled or abs(w_ref) < self.angular_deadband:
            self.integral = 0.0
            self.last_sign = 0.0
            out.angular.z = w_ref
        else:
            sign = math.copysign(1.0, w_ref)
            if sign != self.last_sign:
                self.integral = 0.0          # new turn direction
            self.last_sign = sign
            pivot = abs(msg.linear.x) < self.linear_deadband
            if pivot:
                kff, offset = self.kff_inplace, self.offset_inplace
            else:
                kff, offset = self.kff_moving, self.offset_moving
            if odom_fresh:
                # Measured rate in the requested direction; > |w_ref| means
                # the robot is already turning faster than asked.
                ahead = sign * self.yaw_rate - abs(w_ref)
                fade = min(max(1.0 - ahead / self.brake_band, 0.0), 1.0)
                w = sign * (offset * fade + kff * abs(w_ref))
                err = w_ref - self.yaw_rate
                if ahead < 0.0:
                    self.integral = min(max(
                        self.integral + self.ki * err * dt,
                        -self.i_max), self.i_max)
                    w += self.kp * err + self.integral
                else:
                    self.integral *= math.exp(-dt / self.i_bleed_time)
                    w += self.kp_brake * err + self.integral
            else:
                self.integral = 0.0
                w = sign * (offset + kff * abs(w_ref))
            # Never turn the opposite way to the request.
            magnitude = abs(w) if w * w_ref > 0.0 else 0.0
            if pivot:
                magnitude = max(magnitude, self.min_inplace_angular)
            out.angular.z = sign * min(magnitude, self.max_angular_vel)

        self.pub.publish(out)
        self.debug_pub.publish(Vector3(
            x=w_ref, y=self.yaw_rate if odom_fresh else float('nan'),
            z=out.angular.z))


def main():
    rclpy.init()
    node = TurnRateController()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == '__main__':
    main()
